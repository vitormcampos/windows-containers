<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WindowsContainers.UI.ViewModels" x:Class="WindowsContainers.UI.Views.Components.Settings.ContainerDefaultsSection" x:DataType="vm:ContainerDefaultsSettingsViewModel">
    <ScrollViewer><StackPanel Spacing="18" MaxWidth="700">
        <TextBlock Text="{Binding Title}" Classes="title" /><TextBlock Text="{Binding Description}" Classes="body" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,12,0,0">
            <TextBlock Text="Default image" Classes="metric-label" /><TextBox Grid.Column="1" Text="{Binding Image}" />
            <TextBlock Grid.Row="1" Text="Network mode" Classes="metric-label" /><ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding NetworkMode}"><ComboBoxItem Content="Bridged" /><ComboBoxItem Content="None" /></ComboBox>
            <TextBlock Grid.Row="2" Text="Hostname" Classes="metric-label" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HostName}" PlaceholderText="Optional" />
            <TextBlock Grid.Row="3" Text="Domain name" Classes="metric-label" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DomainName}" PlaceholderText="Optional" />
            <TextBlock Grid.Row="4" Text="Working directory" Classes="metric-label" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding WorkingDirectory}" />
            <TextBlock Grid.Row="5" Text="Lifecycle" Classes="metric-label" /><CheckBox Grid.Row="5" Grid.Column="1" Content="Automatically remove stopped containers" IsChecked="{Binding AutoRemove}" />
            <TextBlock Grid.Row="6" Text="Security" Classes="metric-label" /><CheckBox Grid.Row="6" Grid.Column="1" Content="Run as privileged" IsChecked="{Binding Privileged}" />
            <TextBlock Grid.Row="7" Text="GPU" Classes="metric-label" /><CheckBox Grid.Row="7" Grid.Column="1" Content="Enable GPU support" IsChecked="{Binding GpuEnabled}" />
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
