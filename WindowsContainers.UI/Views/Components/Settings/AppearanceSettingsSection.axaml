<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WindowsContainers.UI.ViewModels" x:Class="WindowsContainers.UI.Views.Components.Settings.AppearanceSettingsSection" x:DataType="vm:AppearanceSettingsViewModel">
    <StackPanel Spacing="18" MaxWidth="700">
        <TextBlock Text="{Binding Title}" Classes="title" /><TextBlock Text="{Binding Description}" Classes="body" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" Margin="0,12,0,0">
            <TextBlock Text="Theme" Classes="metric-label" /><ComboBox Grid.Column="1" SelectedItem="{Binding Theme}"><ComboBoxItem Content="System" /><ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" /></ComboBox>
            <TextBlock Grid.Row="1" Text="Density" Classes="metric-label" /><CheckBox Grid.Row="1" Grid.Column="1" Content="Use compact mode" IsChecked="{Binding CompactMode}" />
            <TextBlock Grid.Row="2" Text="Status bar" Classes="metric-label" /><CheckBox Grid.Row="2" Grid.Column="1" Content="Show status bar" IsChecked="{Binding ShowStatusBar}" />
        </Grid>
    </StackPanel>
</UserControl>
