<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WindowsContainers.UI.ViewModels" x:Class="WindowsContainers.UI.Views.Components.Settings.SessionSettingsSection" x:DataType="vm:SessionSettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="18" MaxWidth="700">
            <TextBlock Text="{Binding Title}" Classes="title" />
            <TextBlock Text="{Binding Description}" Classes="body" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" RowSpacing="12" Margin="0,12,0,0">
                <TextBlock Text="Session name" Classes="metric-label" />
                <TextBox Grid.Column="1" Text="{Binding SessionName}" PlaceholderText="Use the default wslc session" />
            </Grid>
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="16" CornerRadius="4">
                <TextBlock Text="Leave this field empty to use the default wslc session. The session name is passed to wslc for container operations." TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
