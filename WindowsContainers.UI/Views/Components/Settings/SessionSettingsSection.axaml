<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WindowsContainers.UI.ViewModels" x:Class="WindowsContainers.UI.Views.Components.Settings.SessionSettingsSection" x:DataType="vm:SessionSettingsViewModel">
    <ScrollViewer><StackPanel Spacing="18" MaxWidth="700">
        <TextBlock Text="{Binding Title}" Classes="title" /><TextBlock Text="{Binding Description}" Classes="body" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" Margin="0,12,0,0">
            <TextBlock Text="Session name" Classes="metric-label" /><TextBox Grid.Column="1" Text="{Binding SessionName}" />
            <TextBlock Grid.Row="1" Text="Storage path" Classes="metric-label" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StoragePath}" />
            <TextBlock Grid.Row="2" Text="CPU count" Classes="metric-label" /><NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding CpuCount}" Minimum="1" Maximum="128" />
            <TextBlock Grid.Row="3" Text="Memory (MB)" Classes="metric-label" /><NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MemoryMb}" Minimum="512" Maximum="1048576" />
            <TextBlock Grid.Row="4" Text="Timeout (seconds)" Classes="metric-label" /><NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="3600" />
            <TextBlock Grid.Row="5" Text="VHD type" Classes="metric-label" /><ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{Binding VhdType}"><ComboBoxItem Content="Dynamic" /><ComboBoxItem Content="Fixed" /></ComboBox>
            <TextBlock Grid.Row="6" Text="VHD size (GB)" Classes="metric-label" /><NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding VhdSizeGb}" Minimum="1" Maximum="1048576" />
            <TextBlock Grid.Row="7" Text="GPU" Classes="metric-label" /><CheckBox Grid.Row="7" Grid.Column="1" Content="Enable GPU support" IsChecked="{Binding GpuEnabled}" />
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
