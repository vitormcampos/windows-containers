<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WindowsContainers.UI.ViewModels" x:Class="WindowsContainers.UI.Views.Components.Settings.RuntimeSettingsSection" x:DataType="vm:RuntimeSettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="18" MaxWidth="700">
            <TextBlock Text="{Binding Title}" Classes="title" />
            <TextBlock Text="{Binding Description}" Classes="body" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" Margin="0,12,0,0">
                <TextBlock Text="Status" Classes="metric-label" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="metric-value" />
                <TextBlock Grid.Row="1" Text="Runtime version" Classes="metric-label" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" />
                <TextBlock Grid.Row="2" Text="Session" Classes="metric-label" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Session}" TextWrapping="Wrap" />
            </Grid>
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="16" CornerRadius="4">
                <TextBlock Text="Windows Containers uses the native wslc runtime directly. No Linux distribution or Docker installation is required." TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
