<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:WindowsContainers.UI.ViewModels" x:Class="WindowsContainers.UI.Views.Components.Settings.RuntimeSettingsSection" x:DataType="vm:RuntimeSettingsViewModel">
    <StackPanel Spacing="18" MaxWidth="700">
        <TextBlock Text="{Binding Title}" Classes="title" />
        <TextBlock Text="{Binding Description}" Classes="body" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" Margin="0,12,0,0">
            <TextBlock Text="Runtime status" Classes="metric-label" /><TextBlock Grid.Column="1" Text="{Binding Status}" />
            <TextBlock Grid.Row="1" Text="Runtime version" Classes="metric-label" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" />
            <TextBlock Grid.Row="2" Text="GPU" Classes="metric-label" /><CheckBox Grid.Row="2" Grid.Column="1" Content="Enable GPU support" IsChecked="{Binding GpuEnabled}" />
            <TextBlock Grid.Row="3" Text="Session startup" Classes="metric-label" /><CheckBox Grid.Row="3" Grid.Column="1" Content="Start the session with the application" IsChecked="{Binding AutoStartSession}" />
        </Grid>
        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="16" CornerRadius="4"><TextBlock Text="The wslc runtime is native to WSL Containers. No Linux distribution or Docker installation is required." TextWrapping="Wrap" /></Border>
    </StackPanel>
</UserControl>
